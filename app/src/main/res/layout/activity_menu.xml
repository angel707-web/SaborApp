<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_saborapp"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAvatarRole"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/shape_circle_avatar"
            android:text="A"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola, admin"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rol: Administrador"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp" />

        <!-- Card Platos -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlatos"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:text="P   Platos"
                android:textStyle="bold"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Mesas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMesas"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:text="M   Mesas"
                android:textStyle="bold"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Pedidos -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPedidos"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:text="P   Pedidos"
                android:textStyle="bold"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Reportes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReportes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:text="R   Reportes"
                android:textStyle="bold"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Salir Outlined -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalir"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_salir"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:cornerRadius="26dp" />
    </LinearLayout>
</LinearLayout>